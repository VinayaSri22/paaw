# =============================================================================
# PAAW Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://paaw:paaw@localhost:5432/paaw

# -----------------------------------------------------------------------------
# Cache (Valkey/Redis)
# -----------------------------------------------------------------------------
VALKEY_URL=valkey://localhost:6379

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------

# Anthropic (Claude) — recommended for PAAW
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (optional)
# OPENAI_API_KEY=sk-your-openai-key-here

# Groq (optional, fast & cheap)
# GROQ_API_KEY=gsk_your-groq-key-here

# Local LLM via Ollama or LM Studio (optional)
# OLLAMA_BASE_URL=http://localhost:11434

# Model configuration (defaults to Claude Sonnet 4.6)
LLM_DEFAULT_MODEL=claude-sonnet-4-6

# Optional separate model for background JOBS (web research + notifications).
# Jobs are agentic and need reliable tool-calling; small local chat models
# often narrate instead of calling tools. Point jobs at a capable model here
# while keeping chat on a local model. Leave unset to reuse LLM_DEFAULT_MODEL.
# LLM_JOB_MODEL=claude-sonnet-4-6

# Lite mode - enable for small/local models with a tiny context window (~4k).
# Chat sends a compact system prompt with NO tool schemas and NO mental-model
# tag instructions, so the prompt fits and the model reliably returns a reply.
# Trade-off: on the chat path, live tool use (web search) and automatic
# memory-building are skipped. Jobs in the Server Room still use full context.
# PAAW_LITE_MODE=true

# -----------------------------------------------------------------------------
# Channel Configuration (optional)
# -----------------------------------------------------------------------------

# Telegram Bot
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Slack
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN=xapp-your-slack-app-token

# Discord
# DISCORD_BOT_TOKEN=your-discord-bot-token
# -----------------------------------------------------------------------------
# WhatsApp (Baileys) - chat with PAAW + job notifications
# See mcp/whatsapp-baileys/README.md for full setup.
# -----------------------------------------------------------------------------
# Mode: how you talk to PAAW on WhatsApp. One of:
#   self_chat  -> bot runs on YOUR number; talk in "Message Yourself" (default)
#   group      -> bot runs on YOUR number; talk in a dedicated group (no 2nd SIM)
#   dedicated  -> bot runs on a SEPARATE number; message it like a contact
WHATSAPP_MODE=self_chat

# Owner identity (your personal WhatsApp).
#   self_chat: optional (auto-detected). Set OWNER_LID if detection misses it.
#   dedicated: OWNER_NUMBER is REQUIRED (the number you message FROM).
# OWNER_NUMBER=919xxxxxx187          # country code, no +
#
# OWNER_LID: WhatsApp usually delivers the sender as a privacy @lid, not the
# phone number. If PAAW ignores your messages, find your LID in the bot logs:
#   docker compose logs -f whatsapp   -> send a message -> look for the line
#   "upsert ... jid=<NUMBER>@lid fromMe=false" and copy <NUMBER> (digits only).
# OWNER_LID=47760xxxx51349           # the number before @lid (no @lid suffix)

# Group mode only: which group to talk in.
# PAAW_GROUP_NAME=PAAW                # group name to match (default: PAAW)
# PAAW_GROUP_JID=120363xxxxxxxxx@g.us # pin exact group id (most reliable)

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false

# Web UI
WEB_HOST=0.0.0.0
WEB_PORT=8080

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret key for sessions (generate with: openssl rand -hex 32)
# SECRET_KEY=your-secret-key-here
